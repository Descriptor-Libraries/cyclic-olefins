# The images this library runs. No secrets in this file.
# To upgrade or roll back: change the two lines below, commit, then run
#   scripts/deploy-library.sh cyclic-olefins
#
# Currently the original (legacy) pair this library ran before the shared
# release. The same two images also carry these fixed names:
#   descriptor-backend:legacy-20250604-ac4908a4285a
#   descriptor-frontend:legacy-20250114-3f24c8234f96
# To move to the shared release, copy BACKEND_IMAGE and FRONTEND_IMAGE from
# ../.env.versions.

BACKEND_IMAGE=descriptor-backend:edge
FRONTEND_IMAGE=descriptor-frontend:edges
